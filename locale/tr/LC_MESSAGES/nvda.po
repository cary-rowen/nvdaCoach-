msgstr "Bugünkü eğitmeniniz {instructor}. "

#: globalPlugins/nvdaCoach/lessonRunner.py:94
msgid "Starting lesson: {title}."
msgstr "Derse başlanıyor: {title}."

#: globalPlugins/nvdaCoach/lessonRunner.py:99
msgid ""
"Press Enter or the Next Step button to advance. F1 repeats the instruction, "
"F2 gives a hint, Escape stops the lesson."
msgstr ""
"Devam etmek için Enter tuşuna basın veya “Sonraki Adım” düğmesine tıklayın. "
"F1 tuşu talimatı tekrarlar, F2 tuşu ipucu verir, Escape tuşu dersi durdurur."

#: globalPlugins/nvdaCoach/lessonRunner.py:118
msgid ""
"Lesson stopped. Press NVDA+Shift+C to choose another lesson, or Ctrl+R to "
"restart this one."
msgstr ""
"Ders durduruldu. Başka bir ders seçmek için NVDA+Shift+C tuşlarına veya bu "
"dersi yeniden başlatmak için Ctrl+R tuşlarına basın."

#: globalPlugins/nvdaCoach/lessonRunner.py:124
msgid "Lesson stopped."
msgstr "Ders durduruldu."

#: globalPlugins/nvdaCoach/lessonRunner.py:164
msgid "Hint {idx} of {total}: {hint}"
msgstr "{total} ipucu {idx}: {hint}"

#: globalPlugins/nvdaCoach/lessonRunner.py:166
msgid "Hint: {hint}"
msgstr "İpucu: {hint}"

#: globalPlugins/nvdaCoach/lessonRunner.py:171
msgid "No additional hint is available for this step."
msgstr "Bu adım için ek ipucu mevcut değil."

#: globalPlugins/nvdaCoach/lessonRunner.py:179
msgid "Step skipped."
msgstr "Adım atlandı."

#: globalPlugins/nvdaCoach/lessonRunner.py:208
msgid "Step {stepNum} of {totalSteps}. "
msgstr "{stepNum} / {totalSteps} adım. "

#: globalPlugins/nvdaCoach/lessonRunner.py:213
msgid ""
"Try it now. When you are ready to continue, press Enter or click Next Step."
msgstr ""
"Şimdi deneyin. Devam etmeye hazır olduğunuzda Enter tuşuna basın veya "
"Sonraki Adım'a tıklayın."

#: globalPlugins/nvdaCoach/lessonRunner.py:229
msgid "PRACTICE AREA — NAVIGATE WITH ARROW KEYS:"
msgstr "ÇALIŞMA ALANI — OK TUŞLARIYLA dolaşın:"

#: globalPlugins/nvdaCoach/lessonRunner.py:284
msgid "Well done, {name}!"
msgstr "Tebrikler, {name}!"

#: globalPlugins/nvdaCoach/lessonRunner.py:284
msgid "Well done."
msgstr "Tebrikler."

#: globalPlugins/nvdaCoach/lessonRunner.py:294
msgid "Lesson complete: {title}! "
msgstr "Ders tamamlandı: {title}! "

#: globalPlugins/nvdaCoach/lessonRunner.py:300
msgid ""
"Press NVDA+Shift+C to open the lesson picker and choose your next lesson or "
"continue to the next chapter. Ctrl+N moves to the next lesson in this "
"category, or Ctrl+R repeats this one."
msgstr ""
"Ders seçiciyi açmak ve bir sonraki dersinizi seçmek veya bir sonraki bölüme "
"gitmek için NVDA+Shift+C tuşlarına basın. Ctrl+N bu kategorideki bir sonraki "
"derse gider veya Ctrl+R dersi yineler."

#: globalPlugins/nvdaCoach/lessonRunner.py:310
msgid "Lesson complete: {title}!"
msgstr "Ders tamamlandı: {title}!"

#: globalPlugins/nvdaCoach/lessonRunner.py:312
msgid "WHAT TO DO NEXT"
msgstr "SONRA NE YAPILMALI"

#: globalPlugins/nvdaCoach/lessonRunner.py:313
msgid "Press NVDA+Shift+C to open the lesson picker."
msgstr "Ders seçiciyi açmak için NVDA+Shift+C tuşlarına basın."

#: globalPlugins/nvdaCoach/lessonRunner.py:314
msgid "Choose the next lesson in this chapter, or start the next chapter."
msgstr "Bu bölümdeki bir sonraki dersi seçin veya sonraki bölüme başlayın."

#: globalPlugins/nvdaCoach/lessonRunner.py:315
msgid "STAY IN THIS CHAPTER"
msgstr "BU BÖLÜMDE KAL"

#: globalPlugins/nvdaCoach/lessonRunner.py:316
msgid "Next lesson in this category."
msgstr "Bu kategorideki bir sonraki ders."

#: globalPlugins/nvdaCoach/lessonRunner.py:317
msgid "Repeat this lesson."
msgstr "Bu dersi tekrarla."

#: globalPlugins/nvdaCoach/lessonRunner.py:318
msgid "Go back to the previous lesson."
msgstr "Önceki derse geri dön."
